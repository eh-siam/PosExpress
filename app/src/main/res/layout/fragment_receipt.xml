<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundOffWhite"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/receiptCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/receiptCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:gravity="center">

                    <!-- Shop Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PaySwift POS Express"
                        android:textColor="@color/primaryNavy"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/business_address"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textAlignment="center"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@drawable/dashed_divider"
                        android:layout_marginVertical="20dp"
                        android:layerType="software" />

                    <!-- Success Indicator -->
                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/successEmerald" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transaction Successful"
                        android:textColor="@color/successEmerald"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@drawable/dashed_divider"
                        android:layout_marginVertical="24dp"
                        android:layerType="software" />

                    <!-- Details Table -->
                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="1">

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView android:text="Customer" android:textColor="@color/textSecondary" android:textSize="13sp" />
                            <TextView android:id="@+id/tvCustomerInfo" android:text="John Doe (+8801...)" android:textColor="@color/textPrimary" android:textStyle="bold" android:gravity="end" android:textSize="13sp" />
                        </TableRow>

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView android:text="Order Type" android:textColor="@color/textSecondary" android:textSize="13sp" />
                            <TextView android:id="@+id/tvOrderType" android:text="Dine-in" android:textColor="@color/textPrimary" android:textStyle="bold" android:gravity="end" android:textSize="13sp" />
                        </TableRow>

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView android:text="Transaction ID" android:textColor="@color/textSecondary" android:textSize="13sp" />
                            <TextView android:id="@+id/tvTxnId" android:text="TXN_12345" android:textColor="@color/textPrimary" android:textStyle="bold" android:gravity="end" android:textSize="13sp" />
                        </TableRow>

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView android:text="Method" android:textColor="@color/textSecondary" android:textSize="13sp" />
                            <TextView android:id="@+id/tvMethod" android:text="Card" android:textColor="@color/textPrimary" android:textStyle="bold" android:gravity="end" android:textSize="13sp" />
                        </TableRow>

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView android:text="Timestamp" android:textColor="@color/textSecondary" android:textSize="13sp" />
                            <TextView android:id="@+id/tvTimestamp" android:text="2026-08-23 12:00" android:textColor="@color/textPrimary" android:textStyle="bold" android:gravity="end" android:textSize="13sp" />
                        </TableRow>
                    </TableLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@drawable/dashed_divider"
                        android:layout_marginVertical="20dp"
                        android:layerType="software" />

                    <!-- Items List -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Item Description"
                                android:textColor="@color/textPrimary"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Price"
                                android:textColor="@color/textPrimary"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutItemsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@drawable/dashed_divider"
                        android:layout_marginVertical="20dp"
                        android:layerType="software" />

                    <!-- Detailed Billing Section -->
                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="1">

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView android:text="Subtotal" android:textColor="@color/textSecondary" android:textSize="14sp" />
                            <TextView android:id="@+id/tvSubtotal" android:text="$0.00" android:textColor="@color/textPrimary" android:gravity="end" android:textSize="14sp" />
                        </TableRow>

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView android:id="@+id/tvDiscountLabel" android:text="Discount (0%)" android:textColor="@color/alertRed" android:textSize="14sp" />
                            <TextView android:id="@+id/tvDiscountAmount" android:text="-$0.00" android:textColor="@color/alertRed" android:gravity="end" android:textSize="14sp" />
                        </TableRow>

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView android:id="@+id/tvTaxLabel" android:text="VAT (0%)" android:textColor="@color/textSecondary" android:textSize="14sp" />
                            <TextView android:id="@+id/tvTaxAmount" android:text="+$0.00" android:textColor="@color/textSecondary" android:gravity="end" android:textSize="14sp" />
                        </TableRow>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginVertical="8dp" />

                        <TableRow>
                            <TextView android:text="Grand Total" android:textColor="@color/primaryNavy" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvGrandTotal" android:text="$0.00" android:textColor="@color/primaryNavy" android:textSize="22sp" android:textStyle="bold" android:gravity="end" />
                        </TableRow>
                    </TableLayout>

                    <!-- Card Details Section (Only for EMV) -->
                    <LinearLayout
                        android:id="@+id/layoutCardDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@drawable/dashed_divider"
                            android:layout_marginVertical="20dp"
                            android:layerType="software" />

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stretchColumns="1">

                            <TableRow android:layout_marginBottom="8dp">
                                <TextView android:text="Card Type" android:textColor="@color/textSecondary" android:textSize="13sp" />
                                <TextView android:id="@+id/tvCardType" android:text="Visa" android:textColor="@color/textPrimary" android:textStyle="bold" android:gravity="end" android:textSize="13sp" />
                            </TableRow>

                            <TableRow android:layout_marginBottom="8dp">
                                <TextView android:text="Card Number" android:textColor="@color/textSecondary" android:textSize="13sp" />
                                <TextView android:id="@+id/tvCardNumber" android:text="**** **** **** 4242" android:textColor="@color/textPrimary" android:textStyle="bold" android:gravity="end" android:textSize="13sp" />
                            </TableRow>

                            <TableRow>
                                <TextView android:text="Auth Code" android:textColor="@color/textSecondary" android:textSize="13sp" />
                                <TextView android:id="@+id/tvAuthCode" android:text="123456" android:textColor="@color/textPrimary" android:textStyle="bold" android:gravity="end" android:textSize="13sp" />
                            </TableRow>
                        </TableLayout>
                    </LinearLayout>

                    <!-- QR Code Footer -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan for Digital Copy"
                        android:textColor="@color/textSecondary"
                        android:textSize="10sp"
                        android:layout_marginTop="32dp"
                        android:textStyle="italic" />

                    <ImageView
                        android:id="@+id/ivQrCode"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_sort_by_size" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--- THANK YOU ---"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:layout_marginTop="24dp"
                        android:letterSpacing="0.2" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrintReceipt"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Print Receipt"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewTransaction"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="New Sale"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />
    </LinearLayout>

</LinearLayout>
